{
  "name": "agentville",
  "version": "0.1.0",
  "description": "Agentville: your AI coding agents as robots in a little town.",
  "scripts": {
    "start": "vite build && tsx server/index.ts --open",
    "serve": "tsx server/index.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc && tsc -p server && tsc -p test",
    "hooks:install": "tsx server/hooks.ts install",
    "hooks:uninstall": "tsx server/hooks.ts uninstall",
    "hooks:status": "tsx server/hooks.ts status",
    "hooks:debug": "tsx server/hooks.ts debug",
    "simulate": "tsx server/simulate.ts",
    "token": "tsx server/auth.ts",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module"
}
